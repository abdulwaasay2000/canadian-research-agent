# Copy to .env and fill in. Never commit .env.

# --- Mode -------------------------------------------------------------
# Only "research" or "paper" are accepted. Real-money execution does not exist in this codebase.
CRA_MODE=research
CRA_LOG_LEVEL=INFO
# Where DuckDB + HTTP cache live (default ./data)
CRA_DATA_DIR=./data

# --- Free sources -----------------------------------------------------
# SEC requires a descriptive User-Agent with a contact email (fair-access policy).
SEC_USER_AGENT="Your Name your.email@example.com"
# Bank of Canada Valet needs no key.

# --- Keyed sources (optional) ----------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Licensed EOD prices incl. TSX/TSXV (paid plan). Leave blank to skip.
EODHD_API_KEY=

# --- Politeness (seconds between requests per provider) ---------------
CRA_RATE_SEC_S=0.2
CRA_RATE_BOC_S=0.5
CRA_RATE_FRED_S=0.6
CRA_RATE_EODHD_S=0.1
CRA_HTTP_TIMEOUT_S=20
CRA_HTTP_MAX_RETRIES=4
CRA_HTTP_CACHE_TTL_S=21600
